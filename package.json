{
  "name": "@myra/harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "description": "Myra Agents embedded agent harness — deepagents, bun-compiled, talks to the Myra hub as its single LLM endpoint.",
  "scripts": {
    "smoke": "bun run src/index.ts smoke",
    "dev": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "compile": "bun build --compile --minify --target bun-darwin-arm64 --outfile dist/myra-harness src/index.ts"
  },
  "dependencies": {
    "@langchain/openai": "1.5.3",
    "deepagents": "1.10.5"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
